{
  "name": "contextcue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playback-aware, spoiler-safe story comprehension for Fire TV and an Alexa+-style experience.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "bedrock:check": "tsx src/aws/bedrock-check.ts",
    "ingest": "tsx src/ingest/run.ts",
    "render:demo": "node demo/render-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
