# Copy to .env. Never commit .env.

PORT=8787

# file (default, no AWS account) or dynamo
STORE=file
DATA_DIR=data

# amazon.nova-lite-v1:0 is ON_DEMAND in us-west-2 on this account.
# On 2026-10-02 Converse was denied while the account was being verified.
# Uncomment only after `npm run bedrock:check` prints `bedrock ok`.
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-west-2

# Required only when STORE=dynamo or BEDROCK_MODEL_ID is set.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

TIMELINE_PATH=demo/the-lantern-shift/timeline.json

# Dynamo table names (must match infra/lib/contextcue-stack.ts)
FACTS_TABLE=ContextCueFacts
PLAYBACK_TABLE=ContextCuePlayback
PREFERENCES_TABLE=ContextCuePreferences
MEDIA_BUCKET=contextcue-media
