<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0C0E12"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/tray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/missed" style="@style/ActionButton" android:text="What did I miss?" />
            <Button android:id="@+id/who" style="@style/ActionButton" android:text="Who's here?" />
            <Button android:id="@+id/line" style="@style/ActionButton" android:text="Explain that line" />
            <Button android:id="@+id/why" style="@style/ActionButton" android:text="Why it matters" />
            <Button android:id="@+id/dial" style="@style/ActionButton" android:text="Spoiler Dial" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="36dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/card_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/card_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="18dp" />
    </LinearLayout>
</FrameLayout>
